[general]
# 超时测试
server_check_timeout = 3000
# 代理测试
server_check_url = http://cp.cloudflare.com/generate_204
# 自定义解析器
resource_parser_url = https://raw.githubusercontent.com/KOP-XIAO/QuantumultX/master/Scripts/resource-parser.js
# 位置检查
geo_location_checker = http://ip-api.com/json/?lang=zh-CN, https://raw.githubusercontent.com/KOP-XIAO/QuantumultX/master/Scripts/IP_API.js

# 排除路线
excluded_routes = 192.168.0.0/16, 172.16.0.0/12, 10.0.0.0/8, 100.64.0.0/10, 239.255.255.250/32, 24.105.30.129/32, 185.60.112.157/32, 185.60.112.158/32, 182.162.132.1/32
# 排除列表
dns_exclusion_list = *.10099.com.cn, *.cmpassport.com, *.jegotrip.com.cn, *.icitymobile.mobi, id6.me, *.pingan.com.cn, *.cmbchina.com, *.msftconnecttest.com, *.msftncsi.com, captive.apple.com

# UDP回退策略
fallback_udp_policy = reject
# UDP丢弃列表
udp_drop_list = STUN, QUIC

[dns]
# 禁用系统 DNS/IPv6
prefer-doh3
no-system
no-ipv6

# 服务器
doq-server = quic://223.5.5.5, quic://223.6.6.6
doh-server = https://dns.alidns.com/dns-query, https://doh.pub/dns-query
server = 223.5.5.5
server = 119.29.29.29

